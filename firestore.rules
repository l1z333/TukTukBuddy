rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Rules
    match /users/{userId} {
      // Any authenticated student can read profiles
      allow read: if isAuthenticated();
      // Users can only write/update their own profile
      allow write: if isOwner(userId);
    }

    // Trip Rules
    match /trips/{tripId} {
      // Any authenticated user can read open trips
      allow read: if isAuthenticated();

      // Authenticated users can create trips if creatorUid matches their auth.uid
      allow create: if isAuthenticated()
                    && request.resource.data.creatorUid == request.auth.uid
                    && request.resource.data.status == "OPEN";

      // Creator can update status and availableSeats, or delete trip
      allow update, delete: if isAuthenticated()
                            && resource.data.creatorUid == request.auth.uid;
    }

    // Ride Request Rules
    match /rideRequests/{requestId} {
      // Requesters and Trip Creators can read requests relevant to them
      allow read: if isAuthenticated()
                  && (resource.data.requesterUid == request.auth.uid || resource.data.creatorUid == request.auth.uid);

      // Students can create requests for open trips if requesterUid matches auth.uid and they are not the creator
      allow create: if isAuthenticated()
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.requesterUid != request.resource.data.creatorUid
                    && request.resource.data.status == "PENDING";

      // Only the trip creator can update request status (Accept / Reject)
      allow update: if isAuthenticated()
                    && resource.data.creatorUid == request.auth.uid
                    && (request.resource.data.status == "ACCEPTED" || request.resource.data.status == "REJECTED");
    }
  }
}